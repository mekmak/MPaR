@{
    ViewBag.Title = "Games";
}

<div class="container-fluid">
    <div class="container-fluid">
        <div class="row justify-content-center p-3">
            <div class="col-auto">
                <div class="btn-group btn-group-toggle" id="game_tab_buttons" data-toggle="buttons">
                    <label class="btn btn-secondary">
                        <input id="meatSportsRadio" name="sport-type" type="radio" data-sport-type="meat">Meat
                    </label>
                    @*<label class="btn btn-secondary active">
                        <input id="ncaaRadio" name="sport-type" type="radio" data-sport-type="ncaa">NCAA
                    </label>*@
	                <label class="btn btn-secondary">
                        <input id="f1Radio" name="sport-type" type="radio" data-sport-type="f1">F1 Races
                    </label>
	                <label class="btn btn-secondary">
		                <input id="f1StRadio" name="sport-type" type="radio" data-sport-type="f1St">F1 Standings
	                </label>
	                <label class="btn btn-secondary">
		                <input id="wcRadio" name="sport-type" type="radio" data-sport-type="wc">World Cup
	                </label>
	                @*<label class="btn btn-secondary">
                        <input id="owlRadio" name="sport-type" type="radio" data-sport-type="owl" >OWL/G
                    </label>
                    <label class="btn btn-secondary">
                        <input id="owlStRadio" name="sport-type" type="radio" data-sport-type="owlSt">OWL/S
                    </label>*@
                </div>
            </div>
        </div>
        <div class="row justify-content-center pb-3">
            <div class="col-auto">
                <div id="last_update_time" class="text-secondary"></div>
            </div>
        </div>
        <div class="row">
            <div class="col" id="game_tabs">
                <div data-sport-type="meat" class="tab-hidden"></div>
                <div data-sport-type="f1" class="tab-hidden"></div>
	            <div data-sport-type="f1St" class="tab-hidden"></div>
	            <div data-sport-type="wc" class="tab-hidden"></div>
	            @*<div data-sport-type="ncaa"></div>*@
                @*<div data-sport-type="owl"></div>
                <div data-sport-type="owlSt" class="tab-hidden"></div>*@
            </div>
        </div>
    </div>
</div>

<script>
    var tabHashMap = {
        'meat': 'main',
        'f1': 'f1-races',
        'f1St': 'f1-standings',
        'wc': 'world-cup'
    };
    var hashTabMap = {
        'main': 'meat',
        'f1-races': 'f1',
        'f1-standings': 'f1St',
        'world-cup': 'wc'
    };

    function getTabFromHash() {
        var hash = window.location.hash.substring(1);
        return hashTabMap[hash] || 'f1';
    }

    function showTab(sportType) {
        $('#game_tabs > div').each(function () {
            if ($(this).data('sport-type') === sportType) {
                $(this).removeClass('tab-hidden').addClass('tab-visible');
            } else {
                $(this).removeClass('tab-visible').addClass('tab-hidden');
            }
        });

        $('#game_tab_buttons label input').each((_, ele) => {
            $(ele).parent().removeClass('active')
        });
        $(`#game_tab_buttons label input[data-sport-type=${sportType}]`).parent().addClass('active');

        history.replaceState(null, '', '#' + tabHashMap[sportType]);
    }

    function diffUpdate(container, newHtml) {
        var $container = $(container);

        // First load: just insert the content
        if (!$container.html().trim()) {
            $container.html(newHtml);
            return;
        }

        var $newContent = $('<div>').html(newHtml);
        var oldRows = $container.find('tr');
        var newRows = $newContent.find('tr');

        // If structure changed (different row count), fall back to full replacement
        if (oldRows.length !== newRows.length) {
            $container.html(newHtml);
            return;
        }

        // Compare cell-by-cell, only update what changed
        oldRows.each(function (rowIdx) {
            var oldCells = $(this).find('td, th');
            var newCells = $(newRows[rowIdx]).find('td, th');

            if (oldCells.length !== newCells.length) {
                // Row structure changed, replace the whole row
                $(this).replaceWith($(newRows[rowIdx]));
                return;
            }

            oldCells.each(function (cellIdx) {
                var oldCell = $(this);
                var newCell = $(newCells[cellIdx]);

                if (oldCell.html() !== newCell.html()) {
                    oldCell.html(newCell.html());
                    // Trigger flash animation
                    oldCell.removeClass('cell-updated');
                    // Force reflow to restart animation
                    void oldCell[0].offsetWidth;
                    oldCell.addClass('cell-updated');
                }
            });
        });
    }

    function reloadGames() {
        var offset = new Date().getTimezoneOffset();
        $('#game_tabs > div').each((_, ele) => {
            var st = $(ele).data('sport-type');
            var url = '@Url.Action("Games", "Games")' + `?gameType=${st}&offset=${offset}`;
            $.get(url, function (html) {
                diffUpdate(ele, html);
            });
        });
        refreshLastUpdated();
    }

    function refreshLastUpdated() {
        var currentDate = new Date();
        var hours = currentDate.getHours().toString().padStart(2, '0');
        var minutes = currentDate.getMinutes().toString().padStart(2, '0');
        var seconds = currentDate.getSeconds().toString().padStart(2, '0');
        $('#last_update_time').html(`<span class="live-dot"></span>Last updated at: ${hours}:${minutes}:${seconds}`);
    }

    function registerSwipes() {
        new Hammer(document.getElementById('game_tabs')).on("swipeleft swiperight", ev => {
            var active = $('#game_tab_buttons label.active');
            var next = ev.type === 'swiperight' ? active.prev() : active.next();
            if (next.length) {
                next.button().click();
            }
        });
    }

    $(function () {
        $('#game_tab_buttons input').each((_, ele) => {
            $(ele).change(() => showTab($(ele).data('sport-type')));
        });

        var isMobile = 'ontouchstart' in document.documentElement && /mobi/i.test(navigator.userAgent);
        if (isMobile) {
            registerSwipes();
        }

        $(window).on('hashchange', function () {
            showTab(getTabFromHash());
        });

        reloadGames();
        showTab(getTabFromHash());
        setInterval(reloadGames, 5000);
    });
</script>
