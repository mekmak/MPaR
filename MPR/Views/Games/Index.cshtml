@{
    ViewBag.Title = "Games";
}

<div class="container-fluid">
    <div class="container-fluid">
        <div class="row justify-content-center p-3 pb-2">
            <div class="col-auto">
                <div class="btn-group btn-group-toggle game-tab-row" id="l1_buttons" data-toggle="buttons">
                    <label class="btn btn-secondary">
                        <input name="l1" type="radio" data-l1="meat">Meat
                    </label>
                    <label class="btn btn-secondary">
                        <input name="l1" type="radio" data-l1="f1">F1
                    </label>
                    <label class="btn btn-secondary">
                        <input name="l1" type="radio" data-l1="wc">World Cup
                    </label>
                </div>
                <div class="btn-group btn-group-toggle game-tab-row mt-2" id="l2_buttons" data-toggle="buttons">
                    <label class="btn btn-secondary" data-l1="meat">
                        <input name="l2" type="radio" data-l1="meat" data-l2="basketball">
                        <span class="d-none d-md-inline">Basketball</span>
                        <span class="d-md-none">Basket</span>
                    </label>
                    <label class="btn btn-secondary" data-l1="meat">
                        <input name="l2" type="radio" data-l1="meat" data-l2="football">
                        <span class="d-none d-md-inline">Football</span>
                        <span class="d-md-none">Foot</span>
                    </label>
                    <label class="btn btn-secondary" data-l1="meat">
                        <input name="l2" type="radio" data-l1="meat" data-l2="hockey">Hockey
                    </label>
                    <label class="btn btn-secondary" data-l1="meat">
                        <input name="l2" type="radio" data-l1="meat" data-l2="baseball">
                        <span class="d-none d-md-inline">Baseball</span>
                        <span class="d-md-none">Base</span>
                    </label>
                    <label class="btn btn-secondary" data-l1="meat">
                        <input name="l2" type="radio" data-l1="meat" data-l2="soccer">Soccer
                    </label>
                    <label class="btn btn-secondary" data-l1="f1">
                        <input name="l2" type="radio" data-l1="f1" data-l2="races">Races
                    </label>
                    <label class="btn btn-secondary" data-l1="f1">
                        <input name="l2" type="radio" data-l1="f1" data-l2="standings">Standings
                    </label>
                    <label class="btn btn-secondary" data-l1="wc">
                        <input name="l2" type="radio" data-l1="wc" data-l2="matches">Matches
                    </label>
                    <label class="btn btn-secondary" data-l1="wc">
                        <input name="l2" type="radio" data-l1="wc" data-l2="standings">Standings
                    </label>
                </div>
            </div>
        </div>
        <div class="row justify-content-center pb-3">
            <div class="col-auto">
                <div id="last_update_time" class="text-secondary"></div>
            </div>
        </div>
        <div class="row">
            <div class="col" id="game_tabs">
                <div data-l1="meat" data-l2="basketball" class="tab-hidden"></div>
                <div data-l1="meat" data-l2="football" class="tab-hidden"></div>
                <div data-l1="meat" data-l2="hockey" class="tab-hidden"></div>
                <div data-l1="meat" data-l2="baseball" class="tab-hidden"></div>
                <div data-l1="meat" data-l2="soccer" class="tab-hidden"></div>
                <div data-l1="f1" data-l2="races" class="tab-hidden"></div>
                <div data-l1="f1" data-l2="standings" class="tab-hidden"></div>
                <div data-l1="wc" data-l2="matches" class="tab-hidden"></div>
                <div data-l1="wc" data-l2="standings" class="tab-hidden"></div>
            </div>
        </div>
    </div>
</div>

<script>
    var TABS = [
        { key: 'meat', children: [
            { key: 'basketball', fetchKey: 'meat' },
            { key: 'football',   fetchKey: 'meat' },
            { key: 'hockey',     fetchKey: 'meat' },
            { key: 'baseball',   fetchKey: 'meat' },
            { key: 'soccer',     fetchKey: 'meat' }
        ]},
        { key: 'f1', children: [
            { key: 'races',     fetchKey: 'f1' },
            { key: 'standings', fetchKey: 'f1St' }
        ]},
        { key: 'wc', children: [
            { key: 'matches',   fetchKey: 'wc' },
            { key: 'standings', fetchKey: 'wcSt' }
        ]}
    ];

    var FLAT_SEQUENCE = [];
    TABS.forEach(l1 => l1.children.forEach(l2 => FLAT_SEQUENCE.push({ l1: l1.key, l2: l2.key })));

    var FETCH_KEY_BY_PAIR = {};
    TABS.forEach(l1 => l1.children.forEach(l2 => { FETCH_KEY_BY_PAIR[l1.key + '/' + l2.key] = l2.fetchKey; }));

    var DEFAULT_PAIR = { l1: 'wc', l2: 'matches' };

    var lastL2PerL1 = {};
    TABS.forEach(l1 => { lastL2PerL1[l1.key] = l1.children[0].key; });

    var currentPair = DEFAULT_PAIR;

    function isValidPair(l1, l2) {
        return FETCH_KEY_BY_PAIR.hasOwnProperty(l1 + '/' + l2);
    }

    function getPairFromHash() {
        var hash = window.location.hash.substring(1);
        var parts = hash.split('/');
        if (parts.length === 2 && isValidPair(parts[0], parts[1])) {
            return { l1: parts[0], l2: parts[1] };
        }
        return DEFAULT_PAIR;
    }

    function showTab(l1, l2) {
        if (!isValidPair(l1, l2)) {
            l1 = DEFAULT_PAIR.l1;
            l2 = DEFAULT_PAIR.l2;
        }

        currentPair = { l1: l1, l2: l2 };
        lastL2PerL1[l1] = l2;

        $('#game_tabs > div').each(function () {
            var $panel = $(this);
            if ($panel.data('l1') === l1 && $panel.data('l2') === l2) {
                $panel.removeClass('tab-hidden').addClass('tab-visible');
            } else {
                $panel.removeClass('tab-visible').addClass('tab-hidden');
            }
        });

        $('#l1_buttons label').removeClass('active');
        $('#l1_buttons input[data-l1="' + l1 + '"]').parent().addClass('active');

        $('#l2_buttons label').each(function () {
            var $label = $(this);
            var labelL1 = $label.data('l1');
            $label.toggleClass('d-none', labelL1 !== l1);
            $label.removeClass('active');
        });
        $('#l2_buttons input[data-l1="' + l1 + '"][data-l2="' + l2 + '"]').parent().addClass('active');

        history.replaceState(null, '', '#' + l1 + '/' + l2);
    }

    function diffUpdate(container, newHtml) {
        var $container = $(container);

        if (!$container.html().trim()) {
            $container.html(newHtml);
            return;
        }

        var $newContent = $('<div>').html(newHtml);
        var oldRows = $container.find('tr');
        var newRows = $newContent.find('tr');

        if (oldRows.length !== newRows.length) {
            $container.html(newHtml);
            return;
        }

        oldRows.each(function (rowIdx) {
            var oldCells = $(this).find('td, th');
            var newCells = $(newRows[rowIdx]).find('td, th');

            if (oldCells.length !== newCells.length) {
                $(this).replaceWith($(newRows[rowIdx]));
                return;
            }

            oldCells.each(function (cellIdx) {
                var oldCell = $(this);
                var newCell = $(newCells[cellIdx]);

                if (oldCell.html() !== newCell.html()) {
                    oldCell.html(newCell.html());
                    oldCell.removeClass('cell-updated');
                    void oldCell[0].offsetWidth;
                    oldCell.addClass('cell-updated');
                }
            });
        });
    }

    function reloadGames() {
        var offset = new Date().getTimezoneOffset();
        $('#game_tabs > div').each(function () {
            var $panel = $(this);
            var l1 = $panel.data('l1');
            var l2 = $panel.data('l2');
            var fetchKey = FETCH_KEY_BY_PAIR[l1 + '/' + l2];
            if (!fetchKey) {
                return;
            }
            var url = '@Url.Action("Games", "Games")' + '?gameType=' + fetchKey + '&offset=' + offset;
            if (fetchKey === 'meat') {
                url += '&sub=' + l2;
            }
            $.get(url, function (html) {
                diffUpdate($panel[0], html);
            });
        });
        refreshLastUpdated();
    }

    function refreshLastUpdated() {
        var currentDate = new Date();
        var hours = currentDate.getHours().toString().padStart(2, '0');
        var minutes = currentDate.getMinutes().toString().padStart(2, '0');
        var seconds = currentDate.getSeconds().toString().padStart(2, '0');
        $('#last_update_time').html('<span class="live-dot"></span>Last updated at: ' + hours + ':' + minutes + ':' + seconds);
    }

    function currentSequenceIndex() {
        for (var i = 0; i < FLAT_SEQUENCE.length; i++) {
            if (FLAT_SEQUENCE[i].l1 === currentPair.l1 && FLAT_SEQUENCE[i].l2 === currentPair.l2) {
                return i;
            }
        }
        return -1;
    }

    function registerSwipes() {
        new Hammer(document.getElementById('game_tabs')).on('swipeleft swiperight', function (ev) {
            var idx = currentSequenceIndex();
            if (idx < 0) {
                return;
            }
            var nextIdx = ev.type === 'swiperight' ? idx - 1 : idx + 1;
            if (nextIdx < 0 || nextIdx >= FLAT_SEQUENCE.length) {
                return;
            }
            var next = FLAT_SEQUENCE[nextIdx];
            showTab(next.l1, next.l2);
        });
    }

    $(function () {
        $('#l1_buttons input').change(function () {
            var l1 = $(this).data('l1');
            showTab(l1, lastL2PerL1[l1]);
        });

        $('#l2_buttons input').change(function () {
            var l1 = $(this).data('l1');
            var l2 = $(this).data('l2');
            showTab(l1, l2);
        });

        var isMobile = 'ontouchstart' in document.documentElement && /mobi/i.test(navigator.userAgent);
        if (isMobile) {
            registerSwipes();
        }

        $(window).on('hashchange', function () {
            var pair = getPairFromHash();
            showTab(pair.l1, pair.l2);
        });

        var initial = getPairFromHash();
        showTab(initial.l1, initial.l2);
        reloadGames();
        setInterval(reloadGames, 5000);
    });
</script>
