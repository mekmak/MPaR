@model MPR.Models.WorldCupSchedule

<table class="table" style="table-layout: fixed;">
    <colgroup>
        <col style="width: 17%" />
        <col style="width: 10%" />
        <col style="width: 20%" />
        <col style="width: 6%" />
        <col style="width: 20%" />
        <col style="width: 10%" />
        <col style="width: 17%" />
    </colgroup>
    <tbody>
        @foreach (var day in Model.Days.OrderBy(d => d.Order))
        {
            <tr>
                <td></td>
                <td></td>
                <td></td>
                <td colspan="1" class="font-weight-bold text-center">@day.Date.ToString("ddd, MMM dd")</td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            foreach (var match in day.Matches)
            {
                <tr>
                    <td class="text-muted">
                        <span class="d-none d-md-inline">@match.LocationFull</span>
                        <span class="d-md-none">@match.LocationShort</span>
                    </td>
                    <td class="text-muted">
                        <span class="d-none d-md-inline">@match.GroupFull</span>
                        <span class="d-md-none">@match.GroupShort</span>
                    </td>
                    <td class="text-right">
                        @if (!string.IsNullOrEmpty(match.HomeLink))
                        {
                            <a href="@match.HomeLink">
                                <span class="d-none d-md-inline">@match.HomeFull</span>
                                <span class="d-md-none">@match.HomeShort</span>
                            </a>
                        }
                        else
                        {
                            <span class="d-none d-md-inline">@match.HomeFull</span>
                            <span class="d-md-none">@match.HomeShort</span>
                        }
                    </td>
                    <td class="text-center text-muted">vs</td>
                    <td class="text-left">
                        @if (!string.IsNullOrEmpty(match.AwayLink))
                        {
                            <a href="@match.AwayLink">
                                <span class="d-none d-md-inline">@match.AwayFull</span>
                                <span class="d-md-none">@match.AwayShort</span>
                            </a>
                        }
                        else
                        {
                            <span class="d-none d-md-inline">@match.AwayFull</span>
                            <span class="d-md-none">@match.AwayShort</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(match.MatchLink))
                        {
                            <a href="@match.MatchLink">@match.StartDate.ToString("HH:mm")</a>
                        }
                        else
                        {
                            @match.StartDate.ToString("HH:mm")
                        }
                    </td>
                    <td>@match.Status</td>
                </tr>
            }
        }
    </tbody>
</table>
